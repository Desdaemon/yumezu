<?xml version="1.0" encoding="utf-8"?>
<!-- Only the middle 72 of the foreground's 108dp survives every launcher's mask, which is the
     square the head is drawn inside. Android 7 has no adaptive icon and draws
     `mipmap-xxxhdpi/ic_launcher.png` unmasked instead. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
