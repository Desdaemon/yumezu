<?xml version="1.0" encoding="utf-8"?>
<!-- `NativeActivity` is the framework's own class, so the apk needs no dex. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="dev.yumezu">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- three-d compiles its shaders as GLSL ES 3.00. -->
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />

    <application
        android:label="yumezu"
        android:icon="@mipmap/ic_launcher"
        android:hasCode="false"
        android:extractNativeLibs="false">
        <!-- An undrawn action bar still shortens the content rect `safe_rect` reads by 56dp. -->
        <activity
            android:name="android.app.NativeActivity"
            android:exported="true"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
            android:screenOrientation="sensorLandscape"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density|uiMode">
            <meta-data
                android:name="android.app.lib_name"
                android:value="yumezu" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
